name: Test email-verified account deletion

on:
  push:
    branches:
      - fix/borrar-datos-requiere-sesion
    paths:
      - "api/borrar-datos.js"
      - "api/_confirmar-borrado.js"
      - "vercel.json"
      - "api/**"
      - "privacidad.html"
      - ".github/workflows/test-delete-verification.yml"
  pull_request:
    branches:
      - continuidad-pairing-before-after-v02
    paths:
      - "api/borrar-datos.js"
      - "api/_confirmar-borrado.js"
      - "vercel.json"
      - "api/**"
      - "privacidad.html"
      - ".github/workflows/test-delete-verification.yml"
  workflow_dispatch:

jobs:
  validate-delete-flow:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - name: Validate API JavaScript syntax
        shell: bash
        run: |
          set -euo pipefail
          node --input-type=module --check < api/borrar-datos.js
          node --input-type=module --check < api/_confirmar-borrado.js
      - name: Validate privacy page script syntax
        shell: bash
        run: |
          set -euo pipefail
          python3 - <<'PY'
          from pathlib import Path
          import re
          html = Path("privacidad.html").read_text()
          scripts = re.findall(r"<script>(.*?)</script>", html, flags=re.S|re.I)
          if not scripts:
              raise SystemExit("No se encontrÃ³ el script de privacidad")
          Path("/tmp/privacidad-script.js").write_text("\n".join(scripts))
          PY
          node --check /tmp/privacidad-script.js
      - name: Assert deletion security contract
        shell: bash
        run: |
          set -euo pipefail
          grep -q 'randomBytes(32)' api/borrar-datos.js
          grep -q 'createHash("sha256")' api/borrar-datos.js
          grep -q 'modo: "verificacion_pendiente"' api/borrar-datos.js
          grep -q 'rpc/confirmar_solicitud_borrado' api/_confirmar-borrado.js
          grep -q 'method: "POST"' api/_confirmar-borrado.js
          grep -q 'Confirmar eliminaciÃ³n definitiva' api/_confirmar-borrado.js
          grep -q 'RESEND_API_KEY' api/borrar-datos.js
          grep -q 'accion === "confirmar"' api/borrar-datos.js
          grep -q '"/api/confirmar-borrado"' vercel.json
          grep -q '/api/borrar-datos?accion=confirmar' vercel.json
          test ! -e api/confirmar-borrado.js
          n=$(find api -type f \( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' -o -name '*.ts' \) ! -name '_*' | wc -l)
          echo "Funciones serverless detectadas: $n"
          test "$n" -le 12
          echo "PASS: syntax and minimum deletion security contract"
